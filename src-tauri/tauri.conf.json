{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI Summorise",
  "version": "0.1.0",
  "identifier": "com.summorise.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "AI Summorise",
        "width": 960,
        "height": 760,
        "minWidth": 640,
        "minHeight": 520,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "app", "dmg"],
    "category": "Productivity",
    "shortDescription": "Локальный суммаризатор и переводчик",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}
